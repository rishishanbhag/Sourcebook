  "devDependencies": {
    "@tailwindcss/vite": "4.1.4",
    "@types/node": "22.10.2",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "supabase": "^2.122.0",
